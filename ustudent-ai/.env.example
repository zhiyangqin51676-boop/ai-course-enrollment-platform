# Copy to .env and fill in. NEVER commit .env.

# ---- LLM provider (lesson 3 onwards) ----
# Default: Groq. Free, ~14,400 requests/day, fast.
#   Sign up: https://console.groq.com → API Keys → Create
#
# All providers below speak the OpenAI-compatible Chat Completions API,
# so swapping is just three env-var changes — no code change.

# === Groq (recommended for the bootcamp) ===
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# === OpenAI (paid, for production demo in lesson 11) ===
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# === OpenRouter (one key, many models) ===
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Backend (从 AI-3 / 第 8 课起) ----
# 默认 localhost:8080 —— 你在 venv 里跑 agent / uvicorn(最常见)时用这个,
# 后端由 `docker-compose -f student-pack/backend.docker-compose.yml up -d` 起在 localhost。
# ⚠️ 如果值写成 http://ustudent-backend:8080(容器名), 你在宿主机跑会解析不了,
#    agent 一调 get_course/enrol 就连不上, 然后【死循环重试撞 recursion limit】。
# 只有当 AI 服务【本身也在 docker-compose 里】跑时才用容器名(那种情况 compose 会自动覆盖这个值)。
USTUDENT_BACKEND_URL=http://localhost:8080

# ---- Service ----
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO
