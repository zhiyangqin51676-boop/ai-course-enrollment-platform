# Copy to .env — never commit .env, never share it.
#
# LLM provider — Lesson 3 起需要,Lesson 1 只跑 stack 可以留空。
# 默认 Groq: https://console.groq.com → API Keys → Create API Key
# 邮箱注册,无需信用卡,免费额度 14,400 请求 / 天。
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# 后端服务地址(docker-compose 内部通信,不用改)
USTUDENT_BACKEND_URL=http://ustudent-backend:8080

# 服务端口
AI_SERVICE_PORT=8000

# 日志详细程度
LOG_LEVEL=INFO
